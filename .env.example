# Copy to .env (never commit .env). Phase 0 makes no LLM calls; these are
# recorded in output and reserved for the first LLM-backed step.

# LLM provider: none | anthropic | openai | ...  (default: none)
FRR_LLM_PROVIDER=none
# Model id for that provider, e.g. a current Claude or GPT model id.
FRR_LLM_MODEL=
# Must be explicitly set to true before any paid API call is allowed.
FRR_ALLOW_PAID_CALLS=false

# Provider keys (only needed once an LLM step exists)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Workspace app (app/server): the local model used by the chat agent, text rewrites, PDF evidence
# extraction and background tasks. One setting; the default lives in app/server/agent.py (DEFAULT_MODEL).
# FRR_MODEL_PROVIDER=ollama
# FRR_MODEL=qwen3.8:27b
# FRR_MODEL_URL=http://localhost:11434/v1
