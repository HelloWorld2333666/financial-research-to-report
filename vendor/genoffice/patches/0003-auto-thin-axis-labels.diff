+  // Automatic thinning (no explicit tickLblSkip, no explicit rotation): single-token labels
+  // such as years cannot wrap, and they overlap long before the 1.3× rotation threshold
+  // (25 annual labels on a half-slide chart). Show every k-th label instead, like
+  // PowerPoint's automatic label interval, so no two labels collide.
+  const rawSlotW = Math.max(plotR - plotX, 10) / nCats
+  const autoSkip =
+    model.catAxis?.tickLblSkip == null && catRotDeg == null && nCats > 2 &&
+    cats.every((c) => !/\s/.test(c)) && maxCatW * 1.15 > rawSlotW
+      ? Math.ceil((maxCatW * 1.35) / rawSlotW)
+      : 1
+  const lblSkip = model.catAxis?.tickLblSkip ?? autoSkip
+  const heuristicSlotW = rawSlotW * lblSkip
